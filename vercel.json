{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": {
    "api/quotes.py": {
      "maxDuration": 60,
      "memory": 1024
    },
    "api/health.py": {
      "maxDuration": 10,
      "memory": 512
    },
    "api/policy.py": {
      "maxDuration": 60,
      "memory": 1024
    },
    "api/mobile/analyze.py": {
      "maxDuration": 60,
      "memory": 512
    },
    "api/mobile/feed.py": {
      "maxDuration": 30,
      "memory": 512
    }
  },
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        }
      ]
    }
  ]
}
